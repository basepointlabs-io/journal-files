<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RevitJournal.Core</RootNamespace>
  </PropertyGroup>

  <!-- The rule base ships inside the assembly so the analyzer works fully offline. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\knowledge-base\rules\*.json" LogicalName="rules/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\knowledge-base\symptoms.json" LogicalName="symptoms.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RevitJournal.Tests" />
  </ItemGroup>

</Project>
