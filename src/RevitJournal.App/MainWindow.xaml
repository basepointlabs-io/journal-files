<Window x:Class="RevitJournal.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RevitJournal.App"
        Title="Revit Journal Analyzer" Width="1280" Height="820" MinWidth="900" MinHeight="560"
        Background="White" FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">

  <Window.Resources>
    <!-- One finding card; used by the answer page and the full report. -->
    <DataTemplate DataType="{x:Type local:FindingView}">
      <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Background="{Binding Severity, Converter={StaticResource SeverityBrush}}" CornerRadius="6,0,0,6" />
          <Expander Grid.Column="1" IsExpanded="{Binding IsExpanded}" Padding="12,8">
            <Expander.Header>
              <StackPanel Orientation="Horizontal">
                <Border Background="{Binding Severity, Converter={StaticResource SeverityBrush}}" CornerRadius="3"
                        Padding="6,1" Margin="0,0,10,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding SeverityText}" Foreground="White" FontSize="10" FontWeight="Bold" />
                </Border>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
              </StackPanel>
            </Expander.Header>

            <StackPanel Margin="4,6,4,4">
              <TextBlock Text="{Binding Cause}" />

              <ItemsControl ItemsSource="{Binding Facts}" Margin="0,8,0,0"
                            Visibility="{Binding HasFacts, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding StringFormat='▸ {0}'}" FontWeight="SemiBold" Margin="0,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="What to do" FontWeight="SemiBold" Margin="0,12,0,4" />
              <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Margin="0,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding EvidenceTitle}" FontWeight="SemiBold" Margin="0,12,0,4" />
                <Border Background="{StaticResource Panel}" CornerRadius="4" Padding="8,6">
                  <TextBox Text="{Binding Evidence, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                           FontFamily="Cascadia Mono, Consolas" FontSize="11.5" TextWrapping="NoWrap"
                           HorizontalScrollBarVisibility="Auto" />
                </Border>
              </StackPanel>

              <TextBlock Margin="0,10,0,0" FontSize="11.5" Foreground="{StaticResource Muted}">
                <Run Text="{Binding Source, Mode=OneWay}" />
                <Hyperlink NavigateUri="{Binding SourceUrl}" RequestNavigate="OnOpenLink">
                  <Run Text="open" />
                </Hyperlink>
              </TextBlock>
            </StackPanel>
          </Expander>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="Bullets">
      <BulletDecorator Margin="0,3">
        <BulletDecorator.Bullet>
          <TextBlock Text="•" Foreground="{StaticResource Muted}" />
        </BulletDecorator.Bullet>
        <TextBlock Text="{Binding}" Margin="8,0,0,0" />
      </BulletDecorator>
    </DataTemplate>

    <!-- Full report for one journal (History page). -->
    <DataTemplate DataType="{x:Type local:ReportView}">
      <StackPanel Margin="28,22,28,28" MaxWidth="980" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Headline}" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="{Binding FilePath}" Foreground="{StaticResource Muted}" Margin="0,4,0,0" FontSize="12" />

        <TextBlock Text="WHAT HAPPENED" Style="{StaticResource SectionTitle}" />
        <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="14,10">
          <ItemsControl ItemsSource="{Binding Summary}" ItemTemplate="{StaticResource Bullets}" />
        </Border>

        <TextBlock Text="{Binding FindingsTitle}" Style="{StaticResource SectionTitle}"
                   Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="No known problems were found in this journal." Margin="0,16,0,0"
                   Visibility="{Binding NoFindings, Converter={StaticResource BoolToVisibility}}" />
        <ItemsControl ItemsSource="{Binding Findings}" />

        <StackPanel Visibility="{Binding ShowLastActions, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="LAST USER ACTIONS" Style="{StaticResource SectionTitle}" />
          <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="14,10">
            <ItemsControl ItemsSource="{Binding LastActions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Margin="0,1" TextWrapping="NoWrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <!-- Answer for a symptom. -->
    <DataTemplate DataType="{x:Type local:DiagnosisView}">
      <StackPanel Margin="40,20,40,32" MaxWidth="980" HorizontalAlignment="Left">
        <TextBlock FontSize="13" Foreground="{StaticResource Muted}">
          <Run Text="{Binding Icon, Mode=OneWay}" />
          <Run Text="{Binding SymptomTitle, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Text="{Binding Headline}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" />
        <TextBlock Text="{Binding Source}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                   Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" />

        <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="14,10" Margin="0,16,0,0"
                Visibility="{Binding HasFacts, Converter={StaticResource BoolToVisibility}}">
          <ItemsControl ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource Bullets}" />
        </Border>

        <StackPanel Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="WHAT WE FOUND" Style="{StaticResource SectionTitle}" />
          <ItemsControl ItemsSource="{Binding Findings}" />
        </StackPanel>

        <TextBlock Text="{Binding NoCauseText}" Margin="0,20,0,0" FontSize="14"
                   Visibility="{Binding ShowNoCause, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{Binding ChecklistTitle}" Style="{StaticResource SectionTitle}" />
        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14,10">
          <ItemsControl ItemsSource="{Binding Checklist}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Margin="0,3" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
          <Button Content="Open the full report for this session" Click="OnOpenFullReport" Style="{StaticResource ToolbarButton}"
                  Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="Back to symptoms" Click="OnHome" Style="{StaticResource ToolbarButton}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <Style x:Key="SymptomButton" TargetType="Button">
      <Setter Property="Margin" Value="0,0,14,14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Card" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="8" Padding="18,16">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Card" Property="Background" Value="#F3F8FF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,10">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="Revit Journal Analyzer" FontSize="16" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="0,0,24,0" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock Text="Revit version" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,8,0" />
          <ComboBox x:Name="VersionPicker" MinWidth="130" VerticalContentAlignment="Center" SelectionChanged="OnVersionChanged" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button Content="What's wrong?" Click="OnHome" Style="{StaticResource ToolbarButton}" />
          <Button Content="History" Click="OnHistory" Style="{StaticResource ToolbarButton}" />
          <Button Content="Open journal…" Click="OnOpenFile" Style="{StaticResource ToolbarButton}" />
          <Button Content="Refresh" Click="OnRefresh" Style="{StaticResource ToolbarButton}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- HOME: pick a symptom -->
    <ScrollViewer x:Name="HomePage" Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="40,32,40,32" MaxWidth="1000" HorizontalAlignment="Left">
        <TextBlock Text="What's wrong with Revit?" FontSize="28" FontWeight="SemiBold" />
        <TextBlock x:Name="HomeSubtitle" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,6,0,0" />

        <Border x:Name="HintBanner" Visibility="Collapsed" Background="#FFF8E5" BorderBrush="#F2D58A" BorderThickness="1"
                CornerRadius="8" Padding="16,12" Margin="0,22,0,0">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="See why" Click="OnHintClick" Style="{StaticResource ToolbarButton}"
                    Margin="12,0,0,0" VerticalAlignment="Center" />
            <TextBlock x:Name="HintText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
        </Border>

        <ItemsControl x:Name="SymptomCards" Margin="0,24,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="3" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:SymptomCard}">
              <Button Style="{StaticResource SymptomButton}" Click="OnSymptomClick" Tag="{Binding}">
                <StackPanel>
                  <TextBlock Text="{Binding Icon}" FontSize="30" />
                  <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" />
                  <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Margin="0,10,0,0" FontSize="13">
          <Run Text="Something else?" Foreground="{StaticResource Muted}" />
          <Hyperlink Click="OnHistory"><Run Text="Browse all Revit sessions on this computer" /></Hyperlink>
        </TextBlock>
      </StackPanel>
    </ScrollViewer>

    <!-- ANSWER for the chosen symptom -->
    <ScrollViewer x:Name="AnswerPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
      <ContentControl x:Name="Answer" />
    </ScrollViewer>

    <!-- HISTORY: every session, grouped by day -->
    <Grid x:Name="HistoryPage" Grid.Row="1" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="400" MinWidth="280" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <DockPanel>
        <!-- Shown when Revit ended abnormally several times in the last week (metric-repeated-crashes). -->
        <Border x:Name="HistoryBanner" DockPanel.Dock="Top" Visibility="Collapsed" Background="#FFF1F0"
                BorderBrush="#FFCECB" BorderThickness="0,0,0,1" Padding="12,10">
          <StackPanel>
            <TextBlock x:Name="HistoryTitle" FontWeight="SemiBold" Foreground="#CF222E" />
            <ItemsControl x:Name="HistoryFacts" Margin="0,4,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="12" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <ListBox x:Name="Sessions" BorderThickness="0" SelectionChanged="OnSelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="{StaticResource Panel}"
                 VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel">
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.ContainerStyle>
                <Style TargetType="GroupItem">
                  <Setter Property="Template">
                    <Setter.Value>
                      <!-- DataContext is the CollectionViewGroup; its Name is the shared DayGroup instance. -->
                      <ControlTemplate TargetType="GroupItem">
                        <Expander IsExpanded="{Binding Name.IsExpanded, Mode=TwoWay}" Background="White"
                                  BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                          <Expander.Header>
                            <DockPanel Margin="2,6,6,6" LastChildFill="True">
                              <TextBlock DockPanel.Dock="Left" Text="{Binding Name.Icon}" FontSize="14" FontWeight="Bold" Width="20"
                                         TextAlignment="Center" VerticalAlignment="Center"
                                         Foreground="{Binding Name.StatusKey, Converter={StaticResource StatusBrush}}" />
                              <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="{Binding Name.Label}" FontWeight="Bold" FontSize="13" />
                                <TextBlock Text="{Binding Name.Summary}" FontSize="11.5"
                                           Foreground="{Binding Name.StatusKey, Converter={StaticResource StatusBrush}}" />
                              </StackPanel>
                            </DockPanel>
                          </Expander.Header>
                          <ItemsPresenter />
                        </Expander>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </GroupStyle.ContainerStyle>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type local:JournalItem}">
              <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="28,8,12,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Ellipse Width="9" Height="9" VerticalAlignment="Top" Margin="0,5,0,0"
                           Fill="{Binding StatusKey, Converter={StaticResource StatusBrush}}" />
                  <StackPanel Grid.Column="1">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Foreground="{StaticResource Muted}" FontSize="11.5" />
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </DockPanel>
                    <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                               Foreground="{Binding StatusKey, Converter={StaticResource StatusBrush}}" />
                    <TextBlock Text="{Binding Headline}" FontSize="12" Foreground="{StaticResource Muted}"
                               TextTrimming="CharacterEllipsis" MaxHeight="34" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource Line}" />

      <DockPanel Grid.Column="2">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="28,12,0,0">
          <Button Content="Show in folder" Click="OnShowInFolder" Style="{StaticResource ToolbarButton}" />
          <Button Content="Copy report" Click="OnCopyReport" Style="{StaticResource ToolbarButton}" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid>
            <ContentControl x:Name="Report" />
            <TextBlock x:Name="EmptyState" Margin="28" Foreground="{StaticResource Muted}" FontSize="14"
                       Text="Open a day on the left and select a session, or drag a journal file (journal.NNNN.txt) onto this window." />
          </Grid>
        </ScrollViewer>
      </DockPanel>
    </Grid>

    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,5" Background="{StaticResource Panel}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11.5"
                   Text="Everything runs on this computer. Nothing is uploaded." />
        <TextBlock x:Name="StatusLine" Foreground="{StaticResource Muted}" FontSize="11.5" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
