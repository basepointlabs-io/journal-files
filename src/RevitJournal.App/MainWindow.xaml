<ui:FluentWindow x:Class="RevitJournal.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:RevitJournal.App"
        Title="Revit Doctor" Width="1100" Height="840" MinWidth="1040" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
        Background="{StaticResource Ground}" Foreground="{StaticResource Ink}"
        FontFamily="{StaticResource AppFontFamily}" FontSize="13"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">

  <!-- Layout and distances follow the FlexiData Configurator: a 52 title bar (8 + 36 + 8), a 280 sidebar on
       the ground, one white card, 4 between controls side by side and 8 for everything else. -->
  <Window.Resources>
    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- One finding card; used by the answer page and the full report. -->
    <DataTemplate DataType="{x:Type local:FindingView}">
      <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="2" Margin="0,0,0,8" Background="White">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Background="{Binding Severity, Converter={StaticResource SeverityBrush}}" CornerRadius="2,0,0,2" />
          <Expander Grid.Column="1" Style="{StaticResource PlainExpander}" IsExpanded="{Binding IsExpanded}" Padding="16,12">
            <Expander.Header>
              <StackPanel Orientation="Horizontal">
                <Border Background="{Binding Severity, Converter={StaticResource SeverityBrush}}" CornerRadius="2"
                        Padding="6,1" Margin="0,0,12,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding SeverityText}" Foreground="White" FontSize="10" FontWeight="SemiBold" TextWrapping="NoWrap" />
                </Border>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Confidence}" FontSize="12" Foreground="{StaticResource Hint}" VerticalAlignment="Center"
                           Margin="12,1,0,0" TextWrapping="NoWrap" />
              </StackPanel>
            </Expander.Header>

            <StackPanel Margin="24,4,8,8">
              <TextBlock Text="{Binding Cause}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />

              <ItemsControl ItemsSource="{Binding Facts}" Margin="0,8,0,0"
                            Visibility="{Binding HasFacts, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding StringFormat='▸ {0}'}" FontWeight="SemiBold" Margin="0,2" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Visibility="{Binding HasCaseSteps, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="What to do in your case" FontWeight="SemiBold" Margin="0,16,0,8" Foreground="{StaticResource Accent}" />
                <Border Background="#EEF3FD" CornerRadius="2" Padding="12,8,12,8">
                  <ItemsControl ItemsSource="{Binding CaseSteps}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 TextWrapping="Wrap" TextAlignment="Left" Margin="0,2" Padding="0" FontFamily="{StaticResource AppFontFamily}" FontSize="13"
                                 Foreground="{StaticResource Ink}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>

              <TextBlock Text="{Binding StepsTitle}" FontWeight="SemiBold" Margin="0,16,0,8" />
              <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Margin="0,2" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding EvidenceTitle}" FontWeight="SemiBold" Margin="0,16,0,8" />
                <Border Background="{StaticResource Panel}" CornerRadius="2" Padding="12,8">
                  <TextBox Text="{Binding Evidence, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                           FontFamily="Cascadia Mono, Consolas" FontSize="11.5" TextWrapping="NoWrap" Padding="0"
                           HorizontalScrollBarVisibility="Auto" />
                </Border>
              </StackPanel>

              <TextBlock Margin="0,16,0,0" FontSize="12" Foreground="{StaticResource Hint}" Text="{Binding Source, Mode=OneWay}" />
              <ItemsControl ItemsSource="{Binding Sources}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0">
                      <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="OnOpenLink" Foreground="{StaticResource LinkInk}">
                        <Run Text="{Binding Title, Mode=OneWay}" />
                      </Hyperlink>
                    </TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Expander>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="Bullets">
      <BulletDecorator Margin="0,2">
        <BulletDecorator.Bullet>
          <TextBlock Text="•" Foreground="{StaticResource Hint}" />
        </BulletDecorator.Bullet>
        <TextBlock Text="{Binding}" Margin="8,0,0,0" TextWrapping="Wrap" />
      </BulletDecorator>
    </DataTemplate>

    <!-- Full report for one journal (History page). -->
    <DataTemplate DataType="{x:Type local:ReportView}">
      <StackPanel Margin="24" MaxWidth="980" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Headline}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding FilePath}" Foreground="{StaticResource Hint}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" />

        <TextBlock Text="WHAT HAPPENED" Style="{StaticResource SectionTitle}" />
        <Border Background="{StaticResource Panel}" CornerRadius="2" Padding="16,12">
          <ItemsControl ItemsSource="{Binding Summary}" ItemTemplate="{StaticResource Bullets}" />
        </Border>

        <TextBlock Text="{Binding FindingsTitle}" Style="{StaticResource SectionTitle}"
                   Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="No known problems were found in this journal." Margin="0,16,0,0"
                   Visibility="{Binding NoFindings, Converter={StaticResource BoolToVisibility}}" />
        <ItemsControl ItemsSource="{Binding Findings}" />

        <StackPanel Visibility="{Binding ShowLastActions, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="LAST USER ACTIONS" Style="{StaticResource SectionTitle}" />
          <Border Background="{StaticResource Panel}" CornerRadius="2" Padding="16,12">
            <ItemsControl ItemsSource="{Binding LastActions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Margin="0,1" TextWrapping="NoWrap" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <!-- Answer for a symptom. -->
    <DataTemplate DataType="{x:Type local:DiagnosisView}">
      <StackPanel Margin="24" MaxWidth="980" HorizontalAlignment="Left">
        <TextBlock FontSize="13" Foreground="{StaticResource Hint}">
          <Run Text="{Binding Icon, Mode=OneWay}" />
          <Run Text="{Binding SymptomTitle, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Text="{Binding Headline}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Source}" Foreground="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0"
                   Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" />

        <Border Background="{StaticResource Panel}" CornerRadius="2" Padding="16,12" Margin="0,16,0,0"
                Visibility="{Binding HasFacts, Converter={StaticResource BoolToVisibility}}">
          <ItemsControl ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource Bullets}" />
        </Border>

        <StackPanel Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="WHAT WE FOUND" Style="{StaticResource SectionTitle}" />
          <ItemsControl ItemsSource="{Binding Findings}" />
        </StackPanel>

        <TextBlock Text="{Binding NoCauseText}" Margin="0,24,0,0" FontSize="14"
                   Visibility="{Binding ShowNoCause, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{Binding ChecklistTitle}" Style="{StaticResource SectionTitle}" />
        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="2" Padding="16,12">
          <ItemsControl ItemsSource="{Binding Checklist}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Margin="0,3" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
          <Button Content="Open the full report for this session" Click="OnOpenFullReport" Style="{StaticResource ToolbarButton}"
                  Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="Back to Right now" Click="OnHome" Style="{StaticResource ToolbarButton}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <Style x:Key="SymptomButton" TargetType="Button">
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="tile" Background="White" BorderBrush="{StaticResource GroundStroke}" BorderThickness="1"
                    CornerRadius="2" Padding="16">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="tile" Property="Background" Value="#F3F7FE" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===== Title bar: logo, name and version on the left; Revit version and window buttons on the right ===== -->
    <Grid>
      <ui:TitleBar x:Name="AppTitleBar" Height="52" Title="" ShowMinimize="False" ShowMaximize="False" ShowClose="False">
        <ui:TitleBar.TrailingContent>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock x:Name="VersionLabel" Text="Revit version" VerticalAlignment="Center" Foreground="{StaticResource Hint}" Margin="0,0,8,0" />
            <ComboBox x:Name="VersionPicker" MinWidth="150" Height="36" VerticalContentAlignment="Center"
                      SelectionChanged="OnVersionChanged" WindowChrome.IsHitTestVisibleInChrome="True" />
            <Border Width="28" />
            <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="Minimize">
              <ui:SymbolIcon Symbol="Subtract24" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button Style="{StaticResource CaptionButton}" Click="OnMaximize" ToolTip="Maximize">
              <ui:SymbolIcon x:Name="MaximizeIcon" Symbol="Square24" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button Style="{StaticResource CaptionCloseButton}" Click="OnCloseWindow" ToolTip="Close (keeps watching Revit in the tray)">
              <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
          </StackPanel>
        </ui:TitleBar.TrailingContent>
      </ui:TitleBar>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False">
        <Image Source="/Icons/logo.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0" />
        <TextBlock Text="Revit Doctor" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap" />
        <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="NoWrap" />
      </StackPanel>
    </Grid>

    <!-- ===== Body: the sessions on the left (like the Configurator's operations), the card on the right ===== -->
    <Grid Grid.Row="1" Margin="8,0,8,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Sidebar, on the ground -->
      <DockPanel Margin="0,0,8,0">
        <!-- Foot: the BasePoint Labs mark and link, as in the Configurator -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Height="44" Margin="0,8,0,0">
          <Image Source="{StaticResource BasePointLabsMark}" Height="14" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock VerticalAlignment="Center" FontSize="13" TextWrapping="NoWrap">
            <Hyperlink NavigateUri="https://basepointlabs.io" RequestNavigate="OnOpenLink" Foreground="{StaticResource LinkInk}">
              <Run Text="basepointlabs.io" />
            </Hyperlink>
          </TextBlock>
        </StackPanel>

        <Grid DockPanel.Dock="Top">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Style="{StaticResource GroundButton}" Click="OnOpenFile" Margin="0,0,4,0" ToolTip="Open a journal file from anywhere">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" Margin="0,0,8,0" />
              <TextBlock Text="Open…" VerticalAlignment="Center" TextWrapping="NoWrap" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Style="{StaticResource GroundButton}" Click="OnRefresh" Margin="4,0,0,0" ToolTip="Read all journals again">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" Margin="0,0,8,0" />
              <TextBlock Text="Refresh" VerticalAlignment="Center" TextWrapping="NoWrap" />
            </StackPanel>
          </Button>
        </Grid>

        <!-- The live overview as the first entry of the list: highlighted while it is the page shown, with the
             current state beside it, so it reads as "where you are" and not as an action. -->
        <RadioButton x:Name="HomeNav" DockPanel.Dock="Top" Style="{StaticResource NavRow}" Click="OnHome" IsChecked="True"
                     Margin="0,8,0,0" ToolTip="The computer and every running Revit, live">
          <DockPanel>
            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Pulse24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"
                           Foreground="{StaticResource Accent}" />
            <Ellipse x:Name="HomeNavDot" DockPanel.Dock="Right" Width="8" Height="8" VerticalAlignment="Center" Margin="8,0,0,0"
                     Fill="{StaticResource Hint}" />
            <StackPanel>
              <TextBlock Text="Right now" FontWeight="SemiBold" />
              <TextBlock x:Name="HomeNavHint" Text="This computer and running Revit" FontSize="12" Foreground="{StaticResource Muted}"
                         TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
        </RadioButton>

        <!-- Running Revit sessions, live from the tray agent -->
        <StackPanel DockPanel.Dock="Top">
          <TextBlock x:Name="LiveTitle" Text="RUNNING NOW" Style="{StaticResource SectionTitle}" Margin="12,16,0,4" Visibility="Collapsed" />
          <ItemsControl x:Name="LiveCards">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:LiveCardView}">
                <Button Click="OnLiveCardClick" Tag="{Binding}" Cursor="Hand" HorizontalContentAlignment="Stretch">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="row" Background="Transparent" CornerRadius="2" Padding="12,6">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="row" Property="Background" Value="{StaticResource HoverFill}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                  <DockPanel>
                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,6,10,0" VerticalAlignment="Top"
                             Fill="{Binding StatusKey, Converter={StaticResource StatusBrush}}" />
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                      <TextBlock Text="{Binding Details}" Foreground="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                  </DockPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="SESSIONS" Style="{StaticResource SectionTitle}" Margin="12,16,0,4" />
        </StackPanel>

        <!-- Every session, grouped by day; selecting one opens its report in the card -->
        <ListBox x:Name="Sessions" BorderThickness="0" Background="Transparent" SelectionChanged="OnSelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0"
                 ItemContainerStyle="{StaticResource ListRow}"
                 VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel">
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.ContainerStyle>
                <Style TargetType="GroupItem">
                  <Setter Property="Template">
                    <Setter.Value>
                      <!-- DataContext is the CollectionViewGroup; its Name is the shared DayGroup instance. -->
                      <ControlTemplate TargetType="GroupItem">
                        <Expander Style="{StaticResource PlainExpander}" Padding="8,6"
                                  IsExpanded="{Binding Name.IsExpanded, Mode=TwoWay}">
                          <Expander.Header>
                            <DockPanel LastChildFill="True">
                              <TextBlock DockPanel.Dock="Left" Text="{Binding Name.Icon}" FontSize="12" FontWeight="SemiBold" Width="14"
                                         TextAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap"
                                         Foreground="{Binding Name.StatusKey, Converter={StaticResource StatusBrush}}" />
                              <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="{Binding Name.Label}" FontWeight="SemiBold" FontSize="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Name.Summary}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{Binding Name.StatusKey, Converter={StaticResource StatusBrush}}" />
                              </StackPanel>
                            </DockPanel>
                          </Expander.Header>
                          <ItemsPresenter />
                        </Expander>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </GroupStyle.ContainerStyle>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type local:JournalItem}">
              <Grid Margin="12,6,8,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="14" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,6,0,0"
                         Fill="{Binding StatusKey, Converter={StaticResource StatusBrush}}" />
                <StackPanel Grid.Column="1">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Foreground="{StaticResource Hint}" FontSize="12" TextWrapping="NoWrap" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                  </DockPanel>
                  <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="NoWrap"
                             Foreground="{Binding StatusKey, Converter={StaticResource StatusBrush}}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- Main column: the white card, and a row on the ground under it -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="2">
          <Grid>
            <!-- HOME: on the left what is going on right now, on the right the way to an answer -->
            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
              <!-- Right now: the same overview the tray icon opens, and what the recent sessions say. -->
              <StackPanel Margin="24" Width="680" HorizontalAlignment="Left">
                <TextBlock Text="Right now" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="This computer and every running Revit, read every 5 seconds." Foreground="{StaticResource Muted}"
                           FontSize="14" Margin="0,4,0,0" />
                <Border x:Name="HealthCard" Visibility="Collapsed" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="2"
                        Padding="20" Margin="0,16,0,16">
                  <local:HealthPanel x:Name="HomeHealth" Wide="True" />
                </Border>

                <Border x:Name="HintBanner" Visibility="Collapsed" Background="#FFF8E5" BorderBrush="#F2D58A" BorderThickness="1"
                        CornerRadius="2" Padding="16,12" Margin="0,0,0,8">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="See why" Click="OnHintClick" Style="{StaticResource ToolbarButton}"
                            Margin="12,0,0,0" VerticalAlignment="Center" Background="White" />
                    <TextBlock x:Name="HintText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </DockPanel>
                </Border>

                <!-- Shown when Revit crashed several times in the last week (metric-repeated-crashes). -->
                <Border x:Name="HistoryBanner" Visibility="Collapsed" Background="#FFF1F0" BorderBrush="#FFCECB" BorderThickness="1"
                        CornerRadius="2" Padding="16,12" Margin="0,0,0,8">
                  <StackPanel>
                    <TextBlock x:Name="HistoryTitle" FontWeight="SemiBold" FontSize="14" Foreground="#CF222E" />
                    <ItemsControl x:Name="HistoryFacts" Margin="0,4,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding StringFormat='• {0}'}" Margin="0,1" TextWrapping="Wrap" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="Pick any session on the left to see its full report." />
              </StackPanel>
            </ScrollViewer>

            <!-- ANSWER for the chosen symptom -->
            <ScrollViewer x:Name="AnswerPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
              <ContentControl x:Name="Answer" />
            </ScrollViewer>

            <!-- REPORT for the session selected on the left -->
            <ScrollViewer x:Name="ReportPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
              <Grid>
                <ContentControl x:Name="Report" />
                <TextBlock x:Name="EmptyState" Margin="24" Foreground="{StaticResource Muted}" FontSize="14" Visibility="Collapsed" />
              </Grid>
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- Row on the ground under the card: status on the left, report actions on the right (report only) -->
        <DockPanel Grid.Row="1" Margin="0,8,0,0" Height="44">
          <StackPanel x:Name="ReportActions" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
            <Button Style="{StaticResource GroundButton}" Click="OnShowInFolder" Width="150" Margin="0,0,4,0">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Folder24" FontSize="16" Margin="0,0,8,0" />
                <TextBlock Text="Show in folder" VerticalAlignment="Center" TextWrapping="NoWrap" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource GroundButton}" Click="OnCopyReport" Width="150">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Copy24" FontSize="16" Margin="0,0,8,0" />
                <TextBlock Text="Copy report" VerticalAlignment="Center" TextWrapping="NoWrap" />
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="StatusLine" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="Everything runs on this computer. Nothing is uploaded." Foreground="{StaticResource Hint}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Grid>
    </Grid>
  </Grid>
</ui:FluentWindow>
