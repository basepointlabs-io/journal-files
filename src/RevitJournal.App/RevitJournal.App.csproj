<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); WPF has none. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RevitJournalAnalyzer</AssemblyName>
    <RootNamespace>RevitJournal.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Lets the project build on non-Windows machines too; it only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevitJournal.Core\RevitJournal.Core.csproj" />
  </ItemGroup>

  <!-- Keep WinForms/System.Drawing out of the global usings so WPF names (Application, Button, Clipboard...) stay unambiguous. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
