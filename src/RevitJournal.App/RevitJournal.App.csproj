<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); WPF has none. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RevitDoctor</AssemblyName>
    <RootNamespace>RevitJournal.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Lets the project build on non-Windows machines too; it only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationIcon>Icons\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevitJournal.Core\RevitJournal.Core.csproj" />
    <!-- The FlexiData Configurator's UI library, same version, so both BasePoint Labs apps look alike. -->
    <PackageReference Include="WPF-UI" Version="3.1.1" />
  </ItemGroup>

  <!-- Manrope (SIL Open Font License, Fonts\Manrope-OFL.txt) and the logo, embedded. -->
  <ItemGroup>
    <Resource Include="Fonts\Manrope-Regular.ttf" />
    <Resource Include="Fonts\Manrope-SemiBold.ttf" />
    <Content Include="Fonts\Manrope-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Icons\logo.png" />
    <Resource Include="Icons\app.ico" />
  </ItemGroup>

  <!-- Keep WinForms/System.Drawing out of the global usings so WPF names (Application, Button, Clipboard...) stay unambiguous. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
