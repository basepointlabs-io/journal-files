<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>RevitJournalAnalyzer</AssemblyName>
    <RootNamespace>RevitJournal.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Lets the project build on non-Windows machines too; it only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RevitJournal.Core\RevitJournal.Core.csproj" />
  </ItemGroup>

</Project>
