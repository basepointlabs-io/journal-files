<Application x:Class="RevitJournal.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:RevitJournal.App"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <local:SeverityBrushConverter x:Key="SeverityBrush" />
      <local:StatusBrushConverter x:Key="StatusBrush" />
      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

      <!-- Manrope everywhere, as in the FlexiData Configurator. Only the font is set globally: colors come
           from the window by inheritance, so the library's controls keep their own. -->
      <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
