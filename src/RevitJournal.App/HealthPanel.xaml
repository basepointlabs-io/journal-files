<UserControl x:Class="RevitJournal.App.HealthPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RevitJournal.App"
             FontFamily="{StaticResource AppFontFamily}" FontSize="13" Foreground="{StaticResource Ink}">
  <!-- The overview at a glance: overall state, memory with its recent curve, processor, disk, each running Revit,
       and at most three things to do. DataContext is a HealthView. Shown in the tray flyout and on the start screen. -->
  <StackPanel>
    <!-- Overall state -->
    <DockPanel>
      <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="18" Margin="0,0,12,0" VerticalAlignment="Top"
              Background="{Binding StatusKey, Converter={StaticResource StatusBrush}}">
        <Ellipse Width="12" Height="12" Fill="White" />
      </Border>
      <StackPanel>
        <TextBlock Text="{Binding StatusTitle}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{Binding StatusReason}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
      </StackPanel>
    </DockPanel>

    <!-- Computer -->
    <TextBlock Text="COMPUTER" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
    <DockPanel>
      <TextBlock DockPanel.Dock="Right" Text="{Binding RamFreeText}" FontWeight="SemiBold" />
      <TextBlock Text="Memory" />
    </DockPanel>
    <ProgressBar Style="{StaticResource Meter}" Value="{Binding RamPercent, Mode=OneWay}" Margin="0,4,0,2"
                 Foreground="{Binding RamKey, Converter={StaticResource MeterBrush}}" />
    <TextBlock Text="{Binding RamText}" Foreground="{StaticResource Hint}" FontSize="12" />

    <!-- Free memory over the last half hour: a falling line is the early warning. -->
    <Border Background="{StaticResource Panel}" CornerRadius="2" Height="48" Margin="0,8,0,0" Padding="0,4">
      <Viewbox Stretch="Fill">
        <Canvas Width="300" Height="40">
          <Polyline Points="{Binding Sparkline}" StrokeThickness="1.5" StrokeLineJoin="Round"
                    Stroke="{Binding RamKey, Converter={StaticResource MeterBrush}}" />
        </Canvas>
      </Viewbox>
    </Border>
    <TextBlock Text="{Binding ForecastText}" Foreground="{StaticResource Hint}" FontSize="12" Margin="0,2,0,0" />

    <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding CpuText}" FontWeight="SemiBold" />
          <TextBlock Text="Processor" />
        </DockPanel>
        <ProgressBar Style="{StaticResource Meter}" Value="{Binding CpuPercent, Mode=OneWay}" Margin="0,4,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding DiskText}" FontWeight="SemiBold" />
          <TextBlock Text="Disk" />
        </DockPanel>
        <ProgressBar Style="{StaticResource Meter}" Value="{Binding DiskPercent, Mode=OneWay}" Margin="0,4,0,0"
                     Foreground="{Binding DiskKey, Converter={StaticResource MeterBrush}}" />
      </StackPanel>
    </Grid>

    <!-- Revit -->
    <TextBlock Text="REVIT" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
    <TextBlock Text="Revit is not running." Foreground="{StaticResource Muted}"
               Visibility="{Binding NoRevit, Converter={StaticResource BoolToVisibility}}" />
    <ItemsControl ItemsSource="{Binding Revits}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type local:RevitHealthRow}">
          <StackPanel Margin="0,0,0,10">
            <DockPanel>
              <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                       Fill="{Binding StatusKey, Converter={StaticResource StatusBrush}}" />
              <TextBlock DockPanel.Dock="Right" Text="{Binding State}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBlock Text="{Binding Numbers}" Foreground="{StaticResource Muted}" FontSize="12" Margin="16,2,0,0" />
            <ProgressBar Style="{StaticResource Meter}" Value="{Binding GdiPercent, Mode=OneWay}" Margin="16,4,0,2"
                         Foreground="{Binding GdiKey, Converter={StaticResource MeterBrush}}" />
            <TextBlock Text="{Binding GdiText}" Foreground="{StaticResource Hint}" FontSize="12" Margin="16,0,0,0" />
            <TextBlock Text="{Binding Sync}" FontSize="12" Margin="16,2,0,0"
                       Foreground="{Binding SyncKey, Converter={StaticResource StatusBrush}}"
                       Visibility="{Binding HasSync, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- What to do -->
    <StackPanel Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="WHAT TO DO" Style="{StaticResource SectionTitle}" Margin="0,8,0,6" />
      <ItemsControl ItemsSource="{Binding Issues}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:HealthIssueRow}">
            <Border BorderThickness="3,0,0,0" Padding="10,2,0,2" Margin="0,0,0,8"
                    BorderBrush="{Binding LevelKey, Converter={StaticResource StatusBrush}}">
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Advice}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</UserControl>
