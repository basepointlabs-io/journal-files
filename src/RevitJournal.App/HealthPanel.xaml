<UserControl x:Class="RevitJournal.App.HealthPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RevitJournal.App"
             FontFamily="{StaticResource AppFontFamily}" FontSize="13" Foreground="{StaticResource Ink}">
  <!-- The overview at a glance: overall state, free memory with its recent curve, disk, each running Revit,
       and at most three things to do. DataContext is a HealthView. Shown in the tray flyout and on the start screen. -->
  <StackPanel>
    <!-- Overall state -->
    <DockPanel>
      <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="18" Margin="0,0,8,0" VerticalAlignment="Center"
              Background="{Binding StatusKey, Converter={StaticResource StatusBrush}}">
        <!-- The state as a sign as well as a colour: a check, a warning triangle, an alarm light. -->
        <Viewbox Width="22" Height="22">
          <Canvas Width="24" Height="24">
            <Path Data="M6,12.5 L10.5,17 L18,8" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
              <Path.Style>
                <Style TargetType="Path">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusKey}" Value="ok">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Path.Style>
            </Path>
            <Path Data="M12,4.5 L20.5,19 H3.5 Z M12,10 V14 M12,16.8 V17" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
              <Path.Style>
                <Style TargetType="Path">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusKey}" Value="warning">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Path.Style>
            </Path>
            <Path Data="M8,16 V12 A4,4 0 0 1 16,12 V16 M6,16 H18 V19.5 H6 Z M12,3 V4.2 M4.2,12 H3 M21,12 H19.8 M5.6,5.6 L6.5,6.5 M18.4,5.6 L17.5,6.5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
              <Path.Style>
                <Style TargetType="Path">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusKey}" Value="crash">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Path.Style>
            </Path>
          </Canvas>
        </Viewbox>
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding StatusTitle}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{Binding StatusReason}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0" />
      </StackPanel>
    </DockPanel>

    <!-- Autodesk services (EU) with a problem right now, from the Autodesk Health Dashboard. -->
    <Border Background="#FFF8E5" BorderBrush="#F2D58A" BorderThickness="1" CornerRadius="4" Padding="16,8" Margin="0,16,0,0"
            Visibility="{Binding HasAutodeskProblems, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding AutodeskChecked}" FontSize="12" Foreground="{StaticResource Hint}" VerticalAlignment="Center" TextWrapping="NoWrap" />
          <TextBlock Text="Autodesk services (EU)" FontWeight="SemiBold" Foreground="#7A4D00" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding AutodeskProblems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:AutodeskProblemRow}">
              <StackPanel Margin="0,8,0,0">
                <TextBlock Text="{Binding Title}" Foreground="#7A4D00" TextWrapping="Wrap" />
                <TextBlock FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap">
                  <Run Text="{Binding Detail, Mode=OneWay}" />
                  <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="OnOpenLink" Foreground="{StaticResource LinkInk}"><Run Text="Open on Autodesk" /></Hyperlink>
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Three tiles: free RAM with its last half hour as a small curve, free disk space, Revit open.
         Each figure turns orange or red when it is low, with what it is measured against under it. -->
    <Grid Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="4" Padding="8">
        <StackPanel>
          <TextBlock Text="Free RAM" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding RamFreeValue}" FontSize="20" FontWeight="SemiBold" Margin="0" Foreground="{Binding RamKey, Converter={StaticResource ValueInk}}" />
          <TextBlock Text="{Binding RamNote}" Foreground="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" />
          <local:MemoryChart Sparkline="True" Height="30" Margin="0,8,0,0" Data="{Binding RamChart}"
                             Stroke="{Binding RamKey, Converter={StaticResource MeterBrush}}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="4" Padding="8">
        <StackPanel>
          <TextBlock Text="{Binding DiskLabel}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding DiskValue}" FontSize="20" FontWeight="SemiBold" Margin="0" Foreground="{Binding DiskKey, Converter={StaticResource ValueInk}}" />
          <TextBlock Text="{Binding DiskNote}" Foreground="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Grid.Column="4" Background="{StaticResource Panel}" CornerRadius="4" Padding="8">
        <StackPanel>
          <TextBlock Text="Revit open" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding RevitCount}" FontSize="20" FontWeight="SemiBold" Margin="0"  />
          <TextBlock Text="{Binding RevitNote}" Foreground="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Every running Revit in one table: the model (and the Revit and what it is doing under it), the RAM it uses and
         needs, and the files behind it, with a divider between columns. The model column takes the rest of the width
         and wraps long names; the others fit their content. Auto columns shrink to nothing for collapsed cells, so the
         narrow tray flyout shows only the model and the RAM columns. A coloured line only when something needs attention. -->
    <StackPanel Grid.IsSharedSizeScope="True" Margin="0,16,0,0" Visibility="{Binding HasRevits, Converter={StaticResource BoolToVisibility}}">
      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
        <Grid TextElement.Foreground="{StaticResource Hint}" TextElement.FontSize="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="C1" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="C2" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="C3" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="C4" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="C5" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Model" Margin="16,0,8,0" />
          <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,0"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="RAM used" /></Border>
          <Border Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,0"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="RAM needed*" /></Border>
          <Border Grid.Column="3" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,0" Visibility="{Binding Wide, RelativeSource={RelativeSource AncestorType=local:HealthPanel}, Converter={StaticResource BoolToVisibility}}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Model file" /></Border>
          <Border Grid.Column="4" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,0" Visibility="{Binding Wide, RelativeSource={RelativeSource AncestorType=local:HealthPanel}, Converter={StaticResource BoolToVisibility}}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Linked models" /></Border>
          <Border Grid.Column="5" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,0" Visibility="{Binding Wide, RelativeSource={RelativeSource AncestorType=local:HealthPanel}, Converter={StaticResource BoolToVisibility}}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Open views" /></Border>
        </Grid>
      </Border>
      <ItemsControl ItemsSource="{Binding Revits}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:RevitHealthRow}">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="C1" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="C2" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="C3" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="C4" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="C5" />
          </Grid.ColumnDefinitions>
                  <DockPanel Margin="0,0,8,0">
                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,6,8,0" VerticalAlignment="Top"
                             Fill="{Binding StatusKey, Converter={StaticResource StatusBrush}}" />
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Under}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0" />
                    </StackPanel>
                  </DockPanel>
                  <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,0"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding RamUsed}" /></Border>
                  <Border Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,0"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding RamNeeded}" Foreground="{Binding RamNeededKey, Converter={StaticResource ValueInk}}" /></Border>
                  <Border Grid.Column="3" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,0" Visibility="{Binding Wide, RelativeSource={RelativeSource AncestorType=local:HealthPanel}, Converter={StaticResource BoolToVisibility}}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding ModelSize}" /></Border>
                  <Border Grid.Column="4" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,0" Visibility="{Binding Wide, RelativeSource={RelativeSource AncestorType=local:HealthPanel}, Converter={StaticResource BoolToVisibility}}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Links}" /></Border>
                  <Border Grid.Column="5" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,0" Visibility="{Binding Wide, RelativeSource={RelativeSource AncestorType=local:HealthPanel}, Converter={StaticResource BoolToVisibility}}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Views}" /></Border>
                </Grid>
                <TextBlock Text="{Binding Attention}" FontSize="12" Margin="16,0,0,0" TextWrapping="Wrap"
                           Foreground="{Binding AttentionKey, Converter={StaticResource StatusBrush}}"
                           Visibility="{Binding HasAttention, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding TableNote}" Foreground="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                 Visibility="{Binding HasTableNote, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>

    <!-- What to do -->
    <StackPanel Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="WHAT TO DO" Style="{StaticResource SectionTitle}" Margin="0,16,0,0" />
      <ItemsControl ItemsSource="{Binding Issues}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:HealthIssueRow}">
            <Border BorderThickness="3,0,0,0" Padding="8,0,0,0" Margin="0,8,0,0"
                    BorderBrush="{Binding LevelKey, Converter={StaticResource StatusBrush}}">
              <!-- Folded to the title; a click on it shows the advice. -->
              <Expander Style="{StaticResource PlainExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Padding="0">
                <Expander.Header>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Expander.Header>
                <TextBlock Text="{Binding Advice}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
              </Expander>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Autodesk services when nothing is wrong (or the page could not be read): one quiet line. -->
    <DockPanel Margin="0,16,0,0" Visibility="{Binding HasAutodeskLine, Converter={StaticResource BoolToVisibility}}">
      <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,4,8,0" VerticalAlignment="Top"
               Fill="{Binding AutodeskLineKey, Converter={StaticResource StatusBrush}}" />
      <TextBlock Text="{Binding AutodeskLine}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
    </DockPanel>
  </StackPanel>
</UserControl>
