<UserControl x:Class="RevitJournal.App.HealthPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RevitJournal.App"
             FontFamily="{StaticResource AppFontFamily}" FontSize="13" Foreground="{StaticResource Ink}">
  <UserControl.Resources>
    <!-- A resource against Autodesk's figures: a dial, the value, and what to note. Used on the start screen (all of
         them) and in the tray overview (RAM and free disk). -->
    <DataTemplate x:Key="RequirementCard" DataType="{x:Type local:RequirementRow}">
      <Border Background="{StaticResource Panel}" CornerRadius="4" Padding="16" Margin="0,0,16,16">
        <StackPanel>
          <DockPanel>
            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,6,8,0" VerticalAlignment="Top"
                     Fill="{Binding LevelKey, Converter={StaticResource StatusBrush}}" />
            <TextBlock Text="{Binding Item}" FontWeight="SemiBold" TextWrapping="Wrap" />
          </DockPanel>
          <local:Gauge Data="{Binding Dial}" Height="104" Margin="0,8,0,0" ToolTip="{Binding Tip}"
                       Visibility="{Binding HasDial, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"
                     Foreground="{Binding LevelKey, Converter={StaticResource ValueInk}}" />
          <TextBlock Text="{Binding Now}" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                     Foreground="{Binding NowKey, Converter={StaticResource ValueInk}}"
                     Visibility="{Binding HasNow, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding Autodesk}" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                     Foreground="{StaticResource Muted}" Margin="0,4,0,0"
                     Visibility="{Binding NoDial, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding Note}" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0"
                     Foreground="{Binding LevelKey, Converter={StaticResource StatusBrush}}"
                     Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <!-- The same on the start screen, two to a row: the dial on the left, the figures on the right. -->
    <DataTemplate x:Key="RequirementCardWide" DataType="{x:Type local:RequirementRow}">
      <Border Background="{StaticResource Panel}" CornerRadius="4" Padding="16" Margin="0,0,16,16">
        <StackPanel>
          <DockPanel>
            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,6,8,0" VerticalAlignment="Top"
                     Fill="{Binding LevelKey, Converter={StaticResource StatusBrush}}" />
            <TextBlock Text="{Binding Item}" FontWeight="SemiBold" TextWrapping="Wrap" />
          </DockPanel>
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3*" />
              <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <local:Gauge Data="{Binding Dial}" Height="132" ToolTip="{Binding Tip}"
                         Visibility="{Binding HasDial, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
              <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="SemiBold"
                           Foreground="{Binding LevelKey, Converter={StaticResource ValueInk}}" />
              </Viewbox>
              <TextBlock Text="{Binding Now}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                         Foreground="{Binding NowKey, Converter={StaticResource ValueInk}}"
                         Visibility="{Binding HasNow, Converter={StaticResource BoolToVisibility}}" />
              <!-- Autodesk's figures in words only for an item without a dial; on a dial they are its numbers (and its tooltip). -->
              <TextBlock Text="{Binding Autodesk}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,4,0,0"
                         Visibility="{Binding NoDial, Converter={StaticResource BoolToVisibility}}" />
              <TextBlock Text="{Binding Note}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                         Foreground="{Binding LevelKey, Converter={StaticResource StatusBrush}}"
                         Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <!-- The overview at a glance: overall state, free memory with its recent curve, disk, each running Revit,
       and at most three things to do. DataContext is a HealthView. Shown in the tray flyout and on the start screen. -->
  <StackPanel>
    <!-- Overall state -->
    <DockPanel>
      <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="18" Margin="0,0,8,0" VerticalAlignment="Center"
              Background="{Binding StatusKey, Converter={StaticResource StatusBrush}}">
        <!-- The state as a sign as well as a colour: a check, a warning triangle, an alarm light. -->
        <Viewbox Width="22" Height="22">
          <Canvas Width="24" Height="24">
            <Path Data="M6,12.5 L10.5,17 L18,8" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
              <Path.Style>
                <Style TargetType="Path">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusKey}" Value="ok">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Path.Style>
            </Path>
            <Path Data="M12,4.5 L20.5,19 H3.5 Z M12,10 V14 M12,16.8 V17" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
              <Path.Style>
                <Style TargetType="Path">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusKey}" Value="warning">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Path.Style>
            </Path>
            <Path Data="M8,16 V12 A4,4 0 0 1 16,12 V16 M6,16 H18 V19.5 H6 Z M12,3 V4.2 M4.2,12 H3 M21,12 H19.8 M5.6,5.6 L6.5,6.5 M18.4,5.6 L17.5,6.5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
              <Path.Style>
                <Style TargetType="Path">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusKey}" Value="crash">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Path.Style>
            </Path>
          </Canvas>
        </Viewbox>
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding StatusTitle}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{Binding StatusReason}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0" />
      </StackPanel>
    </DockPanel>

    <!-- A newer Revit Doctor on GitHub: what is new, and Install update (the installed copy) or a download link. -->
    <Border Background="#EEF4FF" BorderBrush="#B6CCF5" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,16,0,0"
            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" Margin="16,0,0,0">
          <Button Content="Install update" Click="OnInstallUpdate" Padding="16,8"
                  Visibility="{Binding ShowInstallButton, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding UpdateProgress}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap"
                     Visibility="{Binding HasUpdateProgress, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock FontSize="12" Visibility="{Binding ShowDownloadLink, Converter={StaticResource BoolToVisibility}}">
            <Hyperlink NavigateUri="{Binding UpdateUrl}" RequestNavigate="OnOpenLink" Foreground="{StaticResource LinkInk}"><Run Text="Download from GitHub" /></Hyperlink>
          </TextBlock>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="{Binding UpdateTitle}" FontWeight="SemiBold" Foreground="#1F3F7A" TextWrapping="Wrap" />
          <TextBlock Text="{Binding UpdateNotes}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
          <TextBlock FontSize="12" Margin="0,8,0,0">
            <Hyperlink NavigateUri="{Binding UpdateUrl}" RequestNavigate="OnOpenLink" Foreground="{StaticResource LinkInk}"><Run Text="Release notes" /></Hyperlink>
          </TextBlock>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Autodesk services (EU) with a problem right now, from the Autodesk Health Dashboard. -->
    <Border Background="#FFF8E5" BorderBrush="#F2D58A" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,16,0,0"
            Visibility="{Binding HasAutodeskProblems, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding AutodeskChecked}" FontSize="12" Foreground="{StaticResource Hint}" VerticalAlignment="Center" TextWrapping="NoWrap" />
          <TextBlock Text="Autodesk services (EU)" FontWeight="SemiBold" Foreground="#7A4D00" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding AutodeskProblems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:AutodeskProblemRow}">
              <StackPanel Margin="0,8,0,0">
                <TextBlock Text="{Binding Title}" Foreground="#7A4D00" TextWrapping="Wrap" />
                <TextBlock FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap">
                  <Run Text="{Binding Detail, Mode=OneWay}" />
                  <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="OnOpenLink" Foreground="{StaticResource LinkInk}"><Run Text="Open on Autodesk" /></Hyperlink>
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Three tiles: free RAM with its last half hour as a small curve, free disk space, Revit open.
         Each figure turns orange or red when it is low, with what it is measured against under it. In the narrow tray
         flyout a long figure ("212.4 GB") shrinks to fit its tile instead of being cut off. Only a fallback now: the tray
         overview shows the RAM and disk dials, the start screen all dials; the tiles appear only when there are none. -->
    <Grid Margin="0,16,0,0">
      <Grid.Style>
        <Style TargetType="Grid">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Wide, RelativeSource={RelativeSource AncestorType=local:HealthPanel}}" Value="True">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasRequirements}" Value="True">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="4" Padding="16">
        <StackPanel>
          <TextBlock Text="Free RAM" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{Binding RamFreeValue}" FontSize="20" FontWeight="SemiBold" Margin="0" Foreground="{Binding RamKey, Converter={StaticResource ValueInk}}" /></Viewbox>
          <TextBlock Text="{Binding RamNote}" Foreground="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" />
          <local:MemoryChart Sparkline="True" Height="30" Margin="0,8,0,0" Data="{Binding RamChart}"
                             Stroke="{Binding RamKey, Converter={StaticResource MeterBrush}}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="4" Padding="16">
        <StackPanel>
          <TextBlock Text="{Binding DiskLabel}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{Binding DiskValue}" FontSize="20" FontWeight="SemiBold" Margin="0" Foreground="{Binding DiskKey, Converter={StaticResource ValueInk}}" /></Viewbox>
          <TextBlock Text="{Binding DiskNote}" Foreground="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Grid.Column="4" Background="{StaticResource Panel}" CornerRadius="4" Padding="16">
        <StackPanel>
          <TextBlock Text="Revit open" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{Binding RevitCount}" FontSize="20" FontWeight="SemiBold" Margin="0"  /></Viewbox>
          <TextBlock Text="{Binding RevitNote}" Foreground="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Tray overview: the RAM and free disk dials side by side. -->
    <ItemsControl ItemsSource="{Binding CompactRequirements}" Margin="0,16,-16,-16" ItemTemplate="{StaticResource RequirementCard}">
      <ItemsControl.Style>
        <Style TargetType="ItemsControl">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Wide, RelativeSource={RelativeSource AncestorType=local:HealthPanel}}" Value="True">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ItemsControl.Style>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="2" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>

    <!-- RAM used only with two or more Revit: with one, the "Revit open" tile already says it.
         Every running Revit in one table: the model (and the Revit and what it is doing under it), the RAM it uses and
         needs, and the files behind it, with a divider between columns. The model column takes the rest of the width
         and wraps long names; the others fit their content. Auto columns shrink to nothing for collapsed cells, so the
         narrow tray flyout shows only the model and the RAM columns. A coloured line only when something needs attention. -->
    <StackPanel Grid.IsSharedSizeScope="True" Margin="0,16,0,0" Visibility="{Binding HasRevits, Converter={StaticResource BoolToVisibility}}">
      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,8">
        <Grid TextElement.Foreground="{StaticResource Hint}" TextElement.FontSize="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="C1" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="C2" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="C3" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="C4" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="C5" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Model" Margin="16,0,8,0" />
          <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,0" Visibility="{Binding DataContext.ShowRamUsed, RelativeSource={RelativeSource AncestorType=local:HealthPanel}, Converter={StaticResource BoolToVisibility}}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="RAM used" /></Border>
          <Border Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,0"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="RAM needed*" /></Border>
          <Border Grid.Column="3" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,0" Visibility="{Binding Wide, RelativeSource={RelativeSource AncestorType=local:HealthPanel}, Converter={StaticResource BoolToVisibility}}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Model file" /></Border>
          <Border Grid.Column="4" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,0" Visibility="{Binding Wide, RelativeSource={RelativeSource AncestorType=local:HealthPanel}, Converter={StaticResource BoolToVisibility}}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Linked models" /></Border>
          <Border Grid.Column="5" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,0" Visibility="{Binding Wide, RelativeSource={RelativeSource AncestorType=local:HealthPanel}, Converter={StaticResource BoolToVisibility}}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Open views" /></Border>
        </Grid>
      </Border>
      <ItemsControl ItemsSource="{Binding Revits}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:RevitHealthRow}">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="C1" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="C2" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="C3" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="C4" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="C5" />
          </Grid.ColumnDefinitions>
                  <DockPanel Margin="0,0,8,0">
                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,6,8,0" VerticalAlignment="Top"
                             Fill="{Binding StatusKey, Converter={StaticResource StatusBrush}}" />
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Under}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0" />
                      <TextBlock Text="{Binding LinksLine}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="{Binding HasLinksLine, Converter={StaticResource BoolToVisibility}}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Wide, RelativeSource={RelativeSource AncestorType=local:HealthPanel}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </DockPanel>
                  <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,0" Visibility="{Binding DataContext.ShowRamUsed, RelativeSource={RelativeSource AncestorType=local:HealthPanel}, Converter={StaticResource BoolToVisibility}}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding RamUsed}" /></Border>
                  <Border Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,0"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding RamNeeded}" Foreground="{Binding RamNeededKey, Converter={StaticResource ValueInk}}" /></Border>
                  <Border Grid.Column="3" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,0" Visibility="{Binding Wide, RelativeSource={RelativeSource AncestorType=local:HealthPanel}, Converter={StaticResource BoolToVisibility}}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding ModelSize}" /></Border>
                  <Border Grid.Column="4" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,0" Visibility="{Binding Wide, RelativeSource={RelativeSource AncestorType=local:HealthPanel}, Converter={StaticResource BoolToVisibility}}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Links}" /></Border>
                  <Border Grid.Column="5" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="8,0" Visibility="{Binding Wide, RelativeSource={RelativeSource AncestorType=local:HealthPanel}, Converter={StaticResource BoolToVisibility}}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Views}" /></Border>
                </Grid>
                <TextBlock Text="{Binding Attention}" FontSize="12" Margin="16,0,0,0" TextWrapping="Wrap"
                           Foreground="{Binding AttentionKey, Converter={StaticResource StatusBrush}}"
                           Visibility="{Binding HasAttention, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding TableNote}" Foreground="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                 Visibility="{Binding HasTableNote, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>

    <!-- This computer against Autodesk's published figures, one line each with the article; start screen only. -->
    <StackPanel>
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding Wide, RelativeSource={RelativeSource AncestorType=local:HealthPanel}}" Value="True" />
                <Condition Binding="{Binding HasRequirements}" Value="True" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>
      <TextBlock Text="THIS COMPUTER AND AUTODESK'S FIGURES" Style="{StaticResource SectionTitle}" Margin="0,16,0,0" />
      <!-- One card per resource: a dial whose zones and numbers are Autodesk's figures, the needle this computer.
           Hover the dial for Autodesk's figures in words. -->
      <ItemsControl ItemsSource="{Binding Requirements}" Margin="0,8,-16,0" ItemTemplate="{StaticResource RequirementCardWide}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
      <!-- Where the figures come from: each Autodesk article once, under all the cards. -->
      <TextBlock FontSize="12" Foreground="{StaticResource Hint}" Text="Figures on the dials are Autodesk's, from:" />
      <ItemsControl ItemsSource="{Binding RequirementSources}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:SourceLink}">
            <TextBlock FontSize="12">
              <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="OnOpenLink" Foreground="{StaticResource LinkInk}"><Run Text="{Binding Title, Mode=OneWay}" /></Hyperlink>
            </TextBlock>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- What to do -->
    <StackPanel Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="WHAT TO DO" Style="{StaticResource SectionTitle}" Margin="0,16,0,0" />
      <ItemsControl ItemsSource="{Binding Issues}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:HealthIssueRow}">
            <Border BorderThickness="3,0,0,0" Padding="8,0,0,0" Margin="0,8,0,0"
                    BorderBrush="{Binding LevelKey, Converter={StaticResource StatusBrush}}">
              <!-- Folded to the title; a click on it shows the advice. -->
              <Expander Style="{StaticResource PlainExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Padding="0">
                <Expander.Header>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Expander.Header>
                <TextBlock Text="{Binding Advice}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
              </Expander>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</UserControl>
