<Window x:Class="RevitJournal.App.HealthFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RevitJournal.App"
        Title="Revit Journal Analyzer" Width="400" SizeToContent="Height" MaxHeight="760"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{StaticResource Ground}" FontFamily="{StaticResource AppFontFamily}" FontSize="13"
        Deactivated="OnDeactivated">
  <!-- The compact overview that opens from the tray icon: what is going on right now, and a way into the full window. -->
  <Border BorderBrush="{StaticResource GroundStroke}" BorderThickness="1">
    <DockPanel Margin="8">
      <DockPanel DockPanel.Dock="Top" Height="36" Margin="0,0,0,8">
        <Image DockPanel.Dock="Left" Source="/Icons/logo.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0" />
        <TextBlock x:Name="VersionText" DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource Hint}" VerticalAlignment="Center" />
        <TextBlock Text="Revit Journal Analyzer" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>

      <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Click="OnOpenFull" Margin="0,8,0,0" HorizontalAlignment="Stretch">
        <TextBlock Text="Open full analysis" Foreground="White" />
      </Button>

      <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="2">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <local:HealthPanel x:Name="Panel" Margin="16" />
        </ScrollViewer>
      </Border>
    </DockPanel>
  </Border>
</Window>
