<Window x:Class="RevitJournal.App.HealthFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RevitJournal.App"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Revit Doctor" Width="400" SizeToContent="Height" MaxHeight="760"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" UseLayoutRounding="True"
        Background="{StaticResource Ground}" FontFamily="{StaticResource AppFontFamily}" FontSize="13"
        Deactivated="OnDeactivated">
  <!-- The compact overview that opens from the tray icon: what is going on right now, and a way into the full window. -->
  <Border BorderBrush="{StaticResource GroundStroke}" BorderThickness="1">
    <DockPanel Margin="8">
      <DockPanel DockPanel.Dock="Top" Height="36" Margin="0,0,0,8">
        <Image DockPanel.Dock="Left" Source="/Icons/logo.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0" />
        <!-- Close hides the overview (the app keeps watching from the tray); the other button opens the full window. -->
        <Button DockPanel.Dock="Right" Style="{StaticResource GroundButton}" Click="OnClose" Width="36" Height="36" Padding="0" ToolTip="Close">
          <ui:SymbolIcon Symbol="Dismiss20" FontSize="16" />
        </Button>
        <Button DockPanel.Dock="Right" Style="{StaticResource GroundButton}" Click="OnOpenFull" Width="36" Height="36" Padding="0" Margin="0,0,8,0" ToolTip="Open the full window">
          <ui:SymbolIcon Symbol="ArrowMaximize20" FontSize="16" />
        </Button>
        <TextBlock Text="Revit Doctor" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0" />
      </DockPanel>

      <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Click="OnOpenFull" Margin="0,8,0,0" HorizontalAlignment="Stretch">
        <TextBlock Text="Open full analysis" Foreground="White" />
      </Button>

      <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="2">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <local:HealthPanel x:Name="Panel" Margin="16" />
        </ScrollViewer>
      </Border>
    </DockPanel>
  </Border>
</Window>
